{% extends 'base.html.twig' %}

{% block title %}Connexion familles{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            color-scheme: light;
            --bg: #f5efe4;
            --panel: #fffaf0;
            --panel-strong: #eadbc6;
            --text: #32271f;
            --muted: #77695c;
            --accent: #9a5f2d;
            --accent-soft: #c29562;
            --line: #d9c6aa;
        }

        body {
            margin: 0;
            font-family: "Georgia", "Times New Roman", serif;
            background:
                radial-gradient(circle at 16% 18%, rgba(194, 149, 98, 0.24), transparent 28%),
                radial-gradient(circle at 82% 8%, rgba(154, 95, 45, 0.12), transparent 24%),
                linear-gradient(135deg, rgba(255, 250, 240, 0.82), rgba(234, 219, 198, 0.58)),
                var(--bg);
            color: var(--text);
        }

        .wrap {
            min-height: calc(100vh - 47px);
            display: grid;
            place-items: center;
            padding: clamp(22px, 5vw, 58px);
            position: relative;
            overflow: hidden;
        }

        .wrap::before {
            content: "";
            position: absolute;
            width: min(42vw, 430px);
            aspect-ratio: 1;
            left: clamp(24px, 7vw, 92px);
            bottom: clamp(26px, 8vw, 96px);
            border: 1px solid rgba(194, 149, 98, 0.34);
            border-radius: 50%;
            background:
                linear-gradient(var(--accent-soft), var(--accent-soft)) center / 2px 54% no-repeat,
                linear-gradient(90deg, var(--accent-soft), var(--accent-soft)) center / 54% 2px no-repeat,
                rgba(255, 250, 240, 0.38);
            opacity: 0.38;
        }

        .panel {
            width: min(560px, 100%);
            position: relative;
            background: rgba(255, 250, 240, 0.82);
            border: 1px solid rgba(217, 198, 170, 0.92);
            border-radius: 18px;
            padding: clamp(26px, 4vw, 38px);
            box-shadow: 0 18px 48px rgba(77, 52, 18, 0.10);
            backdrop-filter: blur(10px);
        }

        .eyebrow {
            margin: 0 0 12px;
            color: var(--accent);
            font-size: 12px;
            letter-spacing: 0.18em;
            text-transform: uppercase;
        }

        h1 {
            margin: 0 0 12px;
            font-size: clamp(34px, 5vw, 48px);
            line-height: 0.98;
        }

        p {
            margin: 0 0 22px;
            color: var(--muted);
            line-height: 1.5;
            font-size: 16px;
        }

        label {
            display: block;
            margin: 16px 0 8px;
            font-weight: 700;
            color: var(--text);
        }

        input {
            width: 100%;
            box-sizing: border-box;
            padding: 12px 14px;
            border: 1px solid var(--line);
            border-radius: 12px;
            font: inherit;
            background: rgba(255, 249, 239, 0.92);
            color: var(--text);
            outline: 0;
        }

        input:focus {
            border-color: var(--accent-soft);
            box-shadow: 0 0 0 3px rgba(194, 149, 98, 0.22);
        }

        .actions {
            margin-top: 22px;
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }

        button {
            border: 0;
            border-radius: 999px;
            padding: 12px 18px;
            background: var(--accent);
            color: var(--panel);
            font: inherit;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 10px 22px rgba(154, 95, 45, 0.18);
        }

        .hint {
            font-size: 14px;
            color: var(--muted);
        }

        .error {
            margin: 0 0 16px;
            padding: 12px 14px;
            border-radius: 12px;
            border: 1px solid rgba(143, 45, 45, 0.16);
            background: #fce9e5;
            color: #8f2d2d;
        }

        .demo {
            margin-top: 20px;
            padding-top: 18px;
            border-top: 1px solid var(--line);
            color: var(--muted);
            font-size: 14px;
        }

        .register {
            margin-top: 18px;
            font-size: 14px;
        }

        .register a {
            color: var(--accent);
            font-weight: 700;
            text-decoration: none;
        }

        .success {
            margin: 0 0 16px;
            padding: 12px 14px;
            border-radius: 12px;
            border: 1px solid rgba(36, 92, 46, 0.16);
            background: #e8f4e5;
            color: #245c2e;
        }

        @media (max-width: 720px) {
            .wrap::before { display: none; }
            .actions { align-items: stretch; flex-direction: column; }
            button { width: 100%; }
        }
    </style>
{% endblock %}

{% block body %}
    <main class="wrap">
        <section class="panel">
            <div class="eyebrow">Espace familles</div>
            <h1>Connexion familles</h1>
            <p>Cette zone est réservée aux arbres familiaux. Les villes restent publiques.</p>

            {% if app.request.query.get('registered') %}
                <div class="success">Votre compte a bien été créé. Vous pouvez maintenant vous connecter.</div>
            {% endif %}

            {% if error %}
                <div class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post">
                <label for="username">Identifiant</label>
                <input type="text" id="username" name="_username" value="{{ last_username }}" autocomplete="username" required>

                <label for="password">Mot de passe</label>
                <input type="password" id="password" name="_password" autocomplete="current-password" required>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="actions">
                    <button type="submit">Se connecter</button>
                    <span class="hint">Compte démo : <strong>demo_familles</strong> / <strong>demo-familles-2026</strong></span>
                </div>
            </form>

            <div class="demo">
                Le compte démo est prêt pour les essais et pourra être remplacé plus tard par OAuth sans changer la page d’accueil.
            </div>

            <div class="register">
                Vous n’avez pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte et une famille</a>
            </div>
        </section>
    </main>
{% endblock %}
