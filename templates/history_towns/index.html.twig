<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Histoires de villes</title>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
  <style>
    :root{--bg:#151529;--panel:#22223d;--panel2:#29294a;--gold:#d4af37;--text:#eee8dd;--muted:#aaa0a1;--line:rgba(212,175,55,.35)}
    *{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 50% -10%,#30305c 0,var(--bg) 48%);color:var(--text);font-family:Nunito,sans-serif;min-height:100vh}
    button,input,textarea,select{font:inherit}.shell{width:min(1200px,94%);margin:auto}.hero{text-align:center;padding:55px 0 24px}.eyebrow{color:var(--gold);letter-spacing:.16em;text-transform:uppercase;font-size:.76rem}.hero h1{font:700 clamp(2rem,5vw,3.5rem) Cinzel,serif;margin:.3rem 0;color:var(--gold)}.hero p{color:var(--muted);margin:.3rem auto;max-width:680px}
    .toolbar{display:grid;grid-template-columns:minmax(260px,1fr) auto auto;gap:12px;background:rgba(34,34,61,.88);padding:14px;border:1px solid var(--line);border-radius:18px;position:sticky;top:12px;z-index:500;backdrop-filter:blur(14px)}
    .search{position:relative}.search input{width:100%;background:#17172b;border:1px solid rgba(212,175,55,.25);color:#fff;padding:12px 15px;border-radius:12px;outline:none}.suggestions{position:absolute;top:calc(100% + 6px);left:0;right:0;background:#282846;border:1px solid var(--line);border-radius:12px;overflow:hidden;display:none}.suggestions button{display:block;width:100%;text-align:left;border:0;background:transparent;color:#fff;padding:11px 14px;cursor:pointer}.suggestions button:hover{background:rgba(212,175,55,.14)}
    .btn{border:1px solid var(--line);background:rgba(212,175,55,.1);color:var(--gold);padding:11px 15px;border-radius:12px;cursor:pointer;font-weight:700}.btn.primary{background:var(--gold);color:#17172b}.btn.active{box-shadow:0 0 0 2px rgba(212,175,55,.2) inset;background:rgba(212,175,55,.2)}
    .town-head{display:flex;align-items:end;justify-content:space-between;margin:34px 0 12px}.town-head h2{font:600 1.8rem Cinzel;color:#fff;margin:0}.counter{color:var(--muted)}
    .timeline-wrap{overflow-x:auto;padding:25px 8px 55px;scrollbar-color:var(--gold) transparent}.timeline{position:relative;min-width:980px;height:440px;margin:0 25px}.axis{position:absolute;left:0;right:0;top:205px;height:3px;background:linear-gradient(90deg,transparent,var(--gold) 4%,var(--gold) 96%,transparent)}
    .event{position:absolute;top:190px;transform:translateX(-50%);width:180px}.event-dot{width:18px;height:18px;border:4px solid var(--bg);background:var(--gold);border-radius:50%;margin:auto;box-shadow:0 0 0 4px rgba(212,175,55,.18);cursor:pointer}.event-card{position:absolute;width:180px;left:0;background:linear-gradient(145deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:14px;padding:12px;cursor:pointer;transition:.25s}.event:nth-child(odd) .event-card{bottom:35px}.event:nth-child(even) .event-card{top:35px}.event-card:hover{transform:translateY(-3px);border-color:var(--gold)}.event-year{font:700 .8rem Cinzel;color:var(--gold)}.event-title{font-weight:700;margin:5px 0;font-size:.92rem}.event-summary{color:var(--muted);font-size:.78rem;line-height:1.35;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
    #map{height:560px;border-radius:20px;border:1px solid var(--line);overflow:hidden;display:none;margin-bottom:60px}.leaflet-popup-content-wrapper,.leaflet-popup-tip{background:#252543;color:#fff}.map-popup h3{font-family:Cinzel;color:#d4af37;margin:0 0 4px}.map-popup button{background:#d4af37;border:0;border-radius:7px;padding:6px 9px;cursor:pointer}
    .modal{position:fixed;inset:0;background:rgba(5,5,15,.82);display:none;align-items:center;justify-content:center;padding:18px;z-index:1000;backdrop-filter:blur(7px)}.modal.open{display:flex}.modal-card{background:var(--panel);border:1px solid var(--line);border-radius:20px;width:min(720px,100%);max-height:90vh;overflow:auto;padding:24px;position:relative}.close{position:absolute;right:15px;top:12px;background:none;border:0;color:#fff;font-size:1.8rem;cursor:pointer}.modal h2{font-family:Cinzel;color:var(--gold);margin:0 38px 8px 0}.modal .lead{color:var(--muted)}.media-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px;margin-top:18px}.media-grid img,.media-grid video{width:100%;height:190px;object-fit:cover;border-radius:12px;background:#111}
    form{display:grid;gap:12px}.field{display:grid;gap:5px}.field label{color:var(--muted);font-size:.85rem}.field input,.field textarea,.field select{width:100%;background:#16162b;color:#fff;border:1px solid rgba(212,175,55,.28);border-radius:10px;padding:11px}.field textarea{min-height:90px;resize:vertical}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}.notice{background:rgba(96,190,140,.14);color:#9ee0ba;border:1px solid rgba(96,190,140,.3);padding:11px;border-radius:10px;margin:15px 0}
    .empty{text-align:center;color:var(--muted);padding:80px 0}@media(max-width:760px){.toolbar{grid-template-columns:1fr 1fr}.search{grid-column:1/-1}.town-head{align-items:start;flex-direction:column;gap:5px}.grid2{grid-template-columns:1fr}}
  </style>
</head>
<body>
<div class="shell">
  <header class="hero"><div class="eyebrow">Mémoire urbaine interactive</div><h1>Histoires de villes</h1><p>Recherchez une ville, parcourez sa chronologie et retrouvez chaque événement sur la carte.</p></header>
  <section class="toolbar">
    <div class="search"><input id="town-search" autocomplete="off" placeholder="Rechercher Lille, Marseille, Paris…" value="{{ town ? town.name : '' }}" aria-label="Rechercher une ville"><div id="suggestions" class="suggestions"></div></div>
    <button id="view-toggle" class="btn" type="button">Voir sur la carte</button>
    <button id="add-button" class="btn primary" type="button">+ Ajouter un événement</button>
  </section>
  {% if added %}<div class="notice">L’événement a bien été ajouté.</div>{% endif %}
  {% if town %}
    <div class="town-head"><h2>{{ town.name }}</h2><span class="counter">{{ events|length }} événements historiques</span></div>
    <section id="timeline-view" class="timeline-wrap" aria-label="Frise chronologique de {{ town.name }}"><div id="timeline" class="timeline"><div class="axis"></div></div></section>
    <div id="map" aria-label="Carte des événements"></div>
  {% else %}<div class="empty">Aucune ville n’est encore disponible.</div>{% endif %}
</div>

<div id="detail-modal" class="modal" role="dialog" aria-modal="true"><div class="modal-card"><button class="close" data-close="detail-modal">×</button><div id="detail-content"></div></div></div>
<div id="add-modal" class="modal" role="dialog" aria-modal="true"><div class="modal-card"><button class="close" data-close="add-modal">×</button><h2>Ajouter un événement</h2><p class="lead">L’événement sera publié pour {{ town ? town.name : 'la ville choisie' }}.</p>
  <form method="post" action="{{ path('app_history_towns_add') }}" enctype="multipart/form-data">
    <input type="hidden" name="_token" value="{{ csrf_token('add-town-event') }}"><input type="hidden" name="town" value="{{ town ? town.slug : '' }}">
    <div class="grid2"><div class="field"><label>Année</label><input name="year" type="number" min="-4000" max="2100" required></div><div class="field"><label>Libellé de date</label><input name="dateLabel" placeholder="14 juillet 1789"></div></div>
    <div class="field"><label>Titre</label><input name="title" maxlength="180" required></div><div class="field"><label>Résumé</label><textarea name="summary" required></textarea></div><div class="field"><label>Détails</label><textarea name="detail" required></textarea></div>
    <div class="grid2"><div class="field"><label>Latitude (optionnel)</label><input name="latitude" type="number" step="any" value="{{ town ? town.latitude : '' }}"></div><div class="field"><label>Longitude (optionnel)</label><input name="longitude" type="number" step="any" value="{{ town ? town.longitude : '' }}"></div></div>
    <div class="field"><label>Photos ou vidéos (4 fichiers, 4 Mo chacun maximum)</label><input name="media[]" type="file" accept="image/*,video/*" multiple></div><button class="btn primary" type="submit">Publier l’événement</button>
  </form>
</div></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script>
const TOWNS={{ towns|json_encode|raw }};const EVENTS={{ events|json_encode|raw }};const SELECTED={{ town ? {name:town.name,slug:town.slug,latitude:town.latitude,longitude:town.longitude}|json_encode|raw : 'null' }};
const timeline=document.getElementById('timeline');let map=null;let mapMode=false;
function openEvent(id){const e=EVENTS.find(item=>item.id===id);if(!e)return;const root=document.getElementById('detail-content');root.replaceChildren();const h=document.createElement('h2');h.textContent=e.title;const date=document.createElement('div');date.className='eyebrow';date.textContent=e.dateLabel;const lead=document.createElement('p');lead.className='lead';lead.textContent=e.summary;const detail=document.createElement('p');detail.textContent=e.detail;detail.style.lineHeight='1.65';root.append(h,date,lead,detail);if(e.media.length){const grid=document.createElement('div');grid.className='media-grid';e.media.forEach(m=>{const el=document.createElement(m.type==='video'?'video':'img');el.src=m.url;el.alt=m.name||e.title;if(m.type==='video')el.controls=true;el.loading='lazy';grid.append(el)});root.append(grid)}document.getElementById('detail-modal').classList.add('open')}
function renderTimeline(){if(!timeline||!EVENTS.length)return;timeline.querySelectorAll('.event').forEach(n=>n.remove());const min=Math.min(...EVENTS.map(e=>e.year)),max=Math.max(...EVENTS.map(e=>e.year));EVENTS.forEach((e,i)=>{const node=document.createElement('article');node.className='event';node.style.left=`${4+((e.year-min)/Math.max(1,max-min))*92}%`;node.innerHTML='<button class="event-dot" aria-label="Voir '+escapeText(e.title)+'"></button><div class="event-card"><div class="event-year"></div><div class="event-title"></div><div class="event-summary"></div></div>';node.querySelector('.event-year').textContent=e.dateLabel;node.querySelector('.event-title').textContent=e.title;node.querySelector('.event-summary').textContent=e.summary;node.querySelectorAll('button,.event-card').forEach(el=>el.addEventListener('click',()=>openEvent(e.id)));timeline.append(node)})}
function escapeText(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function initMap(){if(map||!SELECTED||typeof L==='undefined')return;map=L.map('map').setView([SELECTED.latitude,SELECTED.longitude],12);L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; OpenStreetMap contributors'}).addTo(map);EVENTS.forEach(e=>{const marker=L.marker([e.latitude,e.longitude]).addTo(map);const box=document.createElement('div');box.className='map-popup';const h=document.createElement('h3');h.textContent=e.title;const p=document.createElement('p');p.textContent=e.dateLabel+' — '+e.summary;const b=document.createElement('button');b.textContent='Plus de détails';b.addEventListener('click',()=>openEvent(e.id));box.append(h,p,b);marker.bindTooltip(e.title);marker.bindPopup(box)})}
document.getElementById('view-toggle')?.addEventListener('click',e=>{mapMode=!mapMode;document.getElementById('timeline-view').style.display=mapMode?'none':'block';document.getElementById('map').style.display=mapMode?'block':'none';e.currentTarget.textContent=mapMode?'Voir la frise':'Voir sur la carte';e.currentTarget.classList.toggle('active',mapMode);if(mapMode){initMap();setTimeout(()=>map.invalidateSize(),50)}});
document.getElementById('add-button')?.addEventListener('click',()=>document.getElementById('add-modal').classList.add('open'));document.querySelectorAll('[data-close]').forEach(b=>b.addEventListener('click',()=>document.getElementById(b.dataset.close).classList.remove('open')));document.querySelectorAll('.modal').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('open')}));
const search=document.getElementById('town-search'),suggestions=document.getElementById('suggestions');function showSuggestions(){const q=search.value.trim().toLocaleLowerCase('fr');const matches=TOWNS.filter(t=>!q||t.name.toLocaleLowerCase('fr').includes(q));suggestions.replaceChildren();matches.forEach(t=>{const b=document.createElement('button');b.type='button';b.textContent=t.name;b.addEventListener('click',()=>location.href='{{ path('app_history_towns') }}?town='+encodeURIComponent(t.slug));suggestions.append(b)});suggestions.style.display=matches.length?'block':'none'}search?.addEventListener('input',showSuggestions);search?.addEventListener('focus',showSuggestions);document.addEventListener('click',e=>{if(!e.target.closest('.search'))suggestions.style.display='none'});renderTimeline();
</script>
</body></html>
