{% extends 'base.html.twig' %}

{% block title %}Nouvelle vue{% endblock %}

{% block body %}
    <div class="page">
        <h1>Nouvelle vue</h1>
        <p>Ajoutez ici votre code HTML et JS.</p>
        <a class="action-link" href="{{ path('app_trees') }}">Retour aux arbres</a>
    </div>
{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            color-scheme: light;
        }

        body {
            font-family: "Georgia", "Times New Roman", serif;
            margin: 0;
            background: #f6f2ea;
            color: #2b2b2b;
        }

        .page {
            max-width: 1100px;
            margin: 0 auto;
            padding: 32px 24px 64px;
        }

        h1 {
            margin: 0 0 20px;
            font-size: 32px;
            letter-spacing: 0.5px;
        }

        .action-link {
            display: inline-block;
            margin-top: 16px;
            padding: 8px 14px;
            border-radius: 999px;
            border: 1px solid #bda890;
            background: #efe6d7;
            color: #2b2b2b;
            text-decoration: none;
            font-weight: 600;
        }

        .action-link:hover {
            background: #e4d6c0;
        }
    </style>
{% endblock %}
